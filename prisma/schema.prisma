generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int             @id @default(autoincrement())
  email       String          @unique
  username    String          @unique
  password    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  profile     PlayerProfile?
}

model PlayerProfile {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique
  level         Int             @default(1)
  experience    Int             @default(0)
  coins         Int             @default(0)
  cash          Int             @default(0)
  lastLogin     DateTime?

  stats         PlayerStats?
  inventory     InventoryItem[]
  artifacts     PlayerArtifact[]

  user          User            @relation(fields: [userId], references: [id])
}

model PlayerStats {
  id          Int      @id @default(autoincrement())
  profileId   Int      @unique
  health      Int      @default(100)
  armor       Int      @default(0)
  strength    Int      @default(0)
  agility     Int      @default(0)
  intelligence Int     @default(0)
  accuracy    Int      @default(0)

  profile     PlayerProfile @relation(fields: [profileId], references: [id])
}

model Weapon {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  priceCoins   Int      @default(100)
  priceCash    Int      @default(0)
  category     String
  min_damage   Int
  max_damage   Int
  amunition    Int
  reloadTime   Float
  fireInterval Float
  accuracy     Int

  inventory   InventoryItem[]
}

model InventoryItem {
  id          Int      @id @default(autoincrement())
  profileId   Int
  weaponId    Int
  equipped    Boolean  @default(false)
  acquiredAt  DateTime @default(now())

  profile     PlayerProfile @relation(fields: [profileId], references: [id])
  weapon      Weapon        @relation(fields: [weaponId], references: [id])
}

model Artifact {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  bonusType    String
  bonusValue   Int       @default(0)
  priceCoins   Int       @default(0)
  priceCash    Int       @default(0)

  players      PlayerArtifact[]
}

model PlayerArtifact {
  id           Int      @id @default(autoincrement())
  profileId    Int
  artifactId   Int
  slot         Int
  equipped     Boolean  @default(false)
  acquiredAt   DateTime @default(now())

  profile      PlayerProfile @relation(fields: [profileId], references: [id])
  artifact     Artifact      @relation(fields: [artifactId], references: [id])

  @@unique([profileId, slot]) // jeden artefakt na slot
}